APP_NAME="The Forge"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DEBUGBAR_ENABLED=false

# The DB_* values are supplied per driver by the workflow job that needs a database.

SCOUT_DRIVER=collection
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
REVERB_APP_ID=1001
REVERB_APP_KEY=test
REVERB_APP_SECRET=secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TELESCOPE_ENABLED=false
HONEYPOT_ENABLED=false
AKISMET_ENABLED=false

NIGHTWATCH_ENABLED=false
NIGHTOWL_ENABLED=false

# Discord Alerts
DISCORD_ALERT_WEBHOOK=
DISCORD_MODS_WEBHOOK=
DISCORD_MOD_NOTIFICATIONS_ROLE_ID=
DISCORD_ADDONS_WEBHOOK=
DISCORD_ADDON_NOTIFICATIONS_ROLE_ID=
